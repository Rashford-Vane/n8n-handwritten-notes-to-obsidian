        "fileName": "/path/to/your/Obsidian Vault/Notes Compressor/Raw notes.md",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1248,
        0
      ],
      "name": "Read/Write Files from Disk1"
