{
  "name": "Handwritten notes to Obsidian (Brain Dump)",
  "nodes": [
    {
      "id": "3bcc699b-4c6e-4f8e-91ef-06d45f33d759",
      "parameters": {
        "downloadAttachments": true,
        "options": {
          "customEmailConfig": "[\"UNSEEN\", [\"SUBJECT\", \"Brain Dump\"]]"
        }
      },
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "name": "Email Trigger (IMAP)",
